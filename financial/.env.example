# App
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
VIORA_AI_ENABLED=false
VIORA_AI_PROVIDER=deepseek
VIORA_AI_MONTHLY_REQUEST_LIMIT=100
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
