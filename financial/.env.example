# App
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Telegram daily reports (real values belong only in server/GitHub secrets)
TEXTILE_TELEGRAM_ENABLED=false
TEXTILE_TELEGRAM_BOT_TOKEN=
TEXTILE_TELEGRAM_BOT_USERNAME=
