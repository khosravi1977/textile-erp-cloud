# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_user
DB_PASSWORD=change_me
DB_NAME=textile_erp
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-here
